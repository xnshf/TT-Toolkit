# Ignore everything by default. Explicitly allow only the tracked paths.
*

# Keep the allowlist itself under version control.
!.gitignore
!README.md

# TauriTavern extension entry files.
!manifest.json
!index.js
!style.css

# Runtime source loaded by the entry files.
!src/
!src/**

# Development assets: tests, docs and the local verification toolchain.
# Local-only assets (AGENTS.md, DEVELOPMENT.md, install-dev.ps1, .agents/,
# .pi/, node_modules/) stay ignored on purpose.
!tests/
!tests/**
!docs/
!docs/**
!scripts/
!scripts/**
!package.json
!package-lock.json
!vite.config.js
